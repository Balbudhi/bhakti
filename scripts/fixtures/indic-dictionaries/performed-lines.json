  {
    "slug": "arunachala-akshara-mana-malai",
    "line": {
      "id": "line-004",
      "source_text": "அழகு சுந்தரம்போல் அகமும் நீயும் உற்று அபின்னமாய் இருப்போம் அருணாசலா",
      "roman": "aḻaku cuntaram pōl akamum nīyum uṟṟu apinnamāy iruppōm aruṇācalā",
      "kind": "verse",
      "performed_context": [
        {
          "before": [
            {
              "id": "line-002",
              "source_text": "அருணாசல சிவ அருணாசல சிவ அருணாசல சிவ அருணாசலா",
              "roman": "aruṇācala civa aruṇācala civa aruṇācala civa aruṇācalā"
            },
            {
              "id": "line-003",
              "source_text": "அருணாசலமென அகமே நினைப்பவர் அகத்தை வேரறுப்பாய் அருணாசலா",
              "roman": "aruṇācalamena akamē ninaippavar akattai vēraṟuppāy aruṇācalā"
            }
          ],
          "after": [
            {
              "id": "line-005",
              "source_text": "அகம் புகுந்து ஈர்த்துன் அககுகை சிறையாய் அமர்வித்தது என்கொல் அருணாசலா",
              "roman": "akam pukuntu īrttun akakukai ciṟaiyāy amarvittatu enkol aruṇācalā"
            },
            {
              "id": "line-006",
              "source_text": "ஆருக்கா வெனை ஆண்டனை அகற்றிடில் அகிலம் பழித்திடும் அருணாசலா",
              "roman": "ārukkā veṉai āṇṭanai akaṟṟiṭil akilam paḻittiṭum aruṇācalā"
            }
          ]
        }
      ],
